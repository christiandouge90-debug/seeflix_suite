# Example environment variables for Vite + React
# Copy this file to `.env.local` or `.env` and fill in your real values.
# NOTE: For Vite to expose variables to your client code, they must be prefixed with VITE_.

# Base URL of the API your app should call
VITE_API_BASE_URL=https://api.example.com

# Optional API key / token (if your API requires one)
VITE_API_KEY=your_api_key_here

# You can add other variables here. Keep secrets in a local .env.local which is ignored by git.